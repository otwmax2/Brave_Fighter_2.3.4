<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:background="@drawable/egame_sdk_popup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/logo"
                android:background="@drawable/egame_sdk_egame_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_toRightOf="@+id/logo"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/close"
                android:background="@drawable/egame_sdk_btn_close_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/egame_sdk_popup_white_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/fee_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#888888"
                        android:id="@+id/game_name_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginRight="10dp"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#888888"
                        android:id="@+id/tools_name_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginRight="10dp"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#888888"
                        android:id="@+id/tools_price_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="1dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#f43400"
                        android:id="@+id/tools_desc_text"
                        android:background="@drawable/egame_sdk_popup_orange_bg"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"/>
                    <ImageView
                        android:background="@drawable/egame_sdk_popup_dotted_line"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"/>
                    <TextView
                        android:textSize="11dp"
                        android:textColor="#888888"
                        android:id="@+id/fee_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginRight="10dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/confirm"
                        android:background="@drawable/egame_sdk_btn_green_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="10dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/one_confirm_btn_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="10dp">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/one_confirm"
                            android:background="@drawable/egame_sdk_btn_green_selector"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginRight="10dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/one_cancel"
                            android:background="@drawable/egame_sdk_btn_grey_selector"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:id="@+id/other_pay_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="38dp"
                        android:layout_marginRight="31dp">
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#3aa9f6"
                            android:id="@+id/alipay"
                            android:paddingTop="5dp"
                            android:paddingRight="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#3aa9f6"
                            android:id="@+id/morepay"
                            android:paddingLeft="5dp"
                            android:paddingTop="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"/>
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/fee_two_layout"
                    android:layout_width="match_parent"
                    android:layout_height="168dp">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#888888"
                        android:id="@+id/two_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginRight="10dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/number_layout"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginRight="10dp">
                        <EditText
                            android:textSize="13dp"
                            android:textColor="#888888"
                            android:id="@+id/input"
                            android:background="@drawable/egame_sdk_popup_import_box"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:inputType="number"
                            android:imeOptions="flagNoExtractUi"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="#888888"
                            android:gravity="center"
                            android:id="@+id/number_tip"
                            android:background="#bbbbbb"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="8dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="9dp"
                        android:layout_marginRight="10dp">
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/number_pay"
                            android:background="@drawable/egame_sdk_btn_green_selector"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="14dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/number_cancel"
                            android:background="@drawable/egame_sdk_btn_grey_selector"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_weight="1"/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/progress_layout"
                    android:layout_width="match_parent"
                    android:layout_height="168dp">
                    <ProgressBar
                        android:id="@+id/progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="59dp"
                        android:indeterminate="false"
                        android:indeterminateDrawable="@drawable/egame_sdk_progress_loading_style"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#888888"
                        android:id="@+id/progress_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_toRightOf="@+id/progress"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/tip_layout"
                    android:layout_width="match_parent"
                    android:layout_height="168dp">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="#888888"
                        android:id="@+id/result_tip"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginRight="10dp"/>
                    <TextView
                        android:textSize="14dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/return_game"
                        android:background="@drawable/egame_sdk_btn_green_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="22dp"
                        android:layout_marginRight="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/list_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/sms_layout"
                        android:background="@drawable/egame_sdk_list_item_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/icon_phone"
                            android:background="@drawable/egame_sdk_icon_pay_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="13dp"
                            android:layout_marginTop="8dp"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="#888888"
                            android:id="@+id/text_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="10dp"
                            android:layout_toRightOf="@+id/icon_phone"/>
                        <TextView
                            android:textSize="11dp"
                            android:textColor="#888888"
                            android:id="@+id/text1_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_toRightOf="@+id/icon_phone"
                            android:layout_below="@+id/text_phone"/>
                        <ImageView
                            android:background="@drawable/egame_sdk_icon_arrow_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:background="@drawable/egame_sdk_popup_parting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/icon_phone"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/alipay_layout"
                        android:background="@drawable/egame_sdk_list_item_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/icon_alipay"
                            android:background="@drawable/egame_sdk_icon_pay_alipay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="13dp"
                            android:layout_marginTop="8dp"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="#888888"
                            android:id="@+id/text_alipay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="10dp"
                            android:layout_toRightOf="@+id/icon_alipay"/>
                        <TextView
                            android:textSize="11dp"
                            android:textColor="#888888"
                            android:id="@+id/text1_alipay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_toRightOf="@+id/icon_alipay"
                            android:layout_below="@+id/text_alipay"/>
                        <ImageView
                            android:background="@drawable/egame_sdk_icon_arrow_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:background="@drawable/egame_sdk_popup_parting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/icon_alipay"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/more_layout"
                        android:background="@drawable/egame_sdk_list_item_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/icon_more"
                            android:background="@drawable/egame_sdk_icon_pay_more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="13dp"
                            android:layout_marginTop="8dp"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="#888888"
                            android:id="@+id/text_more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="10dp"
                            android:layout_toRightOf="@+id/icon_more"/>
                        <TextView
                            android:textSize="11dp"
                            android:textColor="#888888"
                            android:id="@+id/text1_more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_toRightOf="@+id/icon_more"
                            android:layout_below="@+id/text_more"/>
                        <ImageView
                            android:background="@drawable/egame_sdk_icon_arrow_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:background="@drawable/egame_sdk_popup_parting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_below="@+id/icon_more"/>
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
            <ImageView
                android:id="@+id/line"
                android:background="@drawable/egame_sdk_popup_parting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#bbbbbb"
                android:layout_gravity="center_horizontal"
                android:id="@+id/custom_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
